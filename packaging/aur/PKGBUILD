# Maintainer: nujufas <nujufas@gmail.com>
pkgname=quickai-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="GUI to start/stop local GGUF LLMs (Bonsai, Qwen3) via llama.cpp, Vulkan-accelerated"
arch=('x86_64')
url="https://github.com/nujufas/QuickAI"
license=('PolyForm-Noncommercial-1.0.0')
provides=('quickai')
conflicts=('quickai')
source=("$pkgname-$pkgver.tar.gz::https://github.com/nujufas/QuickAI/releases/download/v$pkgver/quickai-$pkgver-linux-x86_64.tar.gz"
        "quickai.desktop"
        "quickai.png")
# Fill in with the real sums after the vX.Y.Z GitHub Release is published,
# e.g. `sha256sum dist/quickai-$pkgver-linux-x86_64.tar.gz packaging/aur/quickai.desktop packaging/aur/quickai.png`.
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

# The bundle isn't a single binary: quickai needs llama-server, its .so
# libs, and models/ sitting right next to its own executable (see the
# main README's "Adding more models" / packaging notes), so it all has to
# stay together under one directory rather than spreading files across
# the usual /usr/bin, /usr/lib, /usr/share split. /opt/quickai plus a
# symlink is the conventional way to package that kind of self-contained
# bundle for Arch.
package() {
    install -d "$pkgdir/opt/quickai"
    cp -a "$srcdir/quickai-$pkgver-linux-x86_64/." "$pkgdir/opt/quickai/"
    install -d "$pkgdir/usr/bin"
    ln -s /opt/quickai/quickai "$pkgdir/usr/bin/quickai"
    install -Dm644 "$srcdir/quickai.desktop" "$pkgdir/usr/share/applications/quickai.desktop"
    install -Dm644 "$srcdir/quickai.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/quickai.png"
}
